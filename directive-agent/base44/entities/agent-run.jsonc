{
  "name": "AgentRun",
  "type": "object",
  "properties": {
    "directive": { "type": "string", "description": "The directive the agent was started with" },
    "status": {
      "type": "string",
      "enum": ["running", "waiting", "done", "error"],
      "description": "running: working; waiting: needs a reply; done: exited"
    },
    "model": { "type": "string", "description": "AI gateway model" },
    "host": { "type": "string", "description": "Machine and Node.js version the agent runs on" }
  },
  "required": ["directive", "status"]
}
