{
  "name": "AgentEvent",
  "type": "object",
  "properties": {
    "run_id": { "type": "string", "description": "AgentRun this event belongs to" },
    "seq": { "type": "number", "description": "Order within the run" },
    "kind": {
      "type": "string",
      "enum": ["tick", "reasoning", "text", "tool-call", "tool-result", "tool-error", "error"],
      "description": "tick: user message sent to the model; the rest are parts of its steps"
    },
    "call_id": { "type": "string", "description": "Tool call ID linking a tool-call to its result" },
    "content": { "type": "string" }
  },
  "required": ["run_id", "kind"]
}
