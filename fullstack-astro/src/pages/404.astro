---
import Layout from "../components/Layout.astro";
import { setPrivateCache } from "../lib/cache";

// Don't let a shared cache store the 404.
setPrivateCache(Astro);
Astro.response.status = 404;
---

<Layout title="Page not found — Meridian">
  <section class="wrap section notfound">
    <p class="eyebrow">404</p>
    <h1>This page has gone cold.</h1>
    <p class="muted">The link may be broken or the page may have moved.</p>
    <a class="btn" href="/">Back to the shop</a>
  </section>
</Layout>

<style>
  .notfound {
    text-align: center;
    padding: 104px 24px;
  }
  .notfound h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin: 6px 0 8px;
  }
  .notfound .btn {
    margin-top: 22px;
  }
</style>
