---
// Completes the OAuth round trip. After a visitor signs in with Google (via
// the platform-reserved /api/apps/auth/* surface, linked from the app-owned
// /login page), they are redirected back with `?access_token=...` in the URL.
// This tiny, dependency-free script captures that token, mirrors it into the
// `base44_access_token` cookie (so server-side `createServerClient` picks up
// the session on the next request), stashes it in localStorage for the
// browser, strips it from the URL, and reloads so the SSR view re-renders as
// the signed-in user. Runs before anything else on every page.
---

<script is:inline>
  (function () {
    try {
      var params = new URLSearchParams(window.location.search);
      var token = params.get("access_token");
      if (!token) return;
      var key = "base44_access_token";
      try {
        localStorage.setItem(key, token);
      } catch (e) {}
      var secure = location.protocol === "https:" ? "; Secure" : "";
      document.cookie =
        key + "=" + token + "; Path=/; Max-Age=2592000; SameSite=Lax" + secure;
      params.delete("access_token");
      var qs = params.toString();
      var clean = location.pathname + (qs ? "?" + qs : "") + location.hash;
      window.location.replace(clean);
    } catch (e) {
      /* no-op: stay logged out */
    }
  })();
</script>
