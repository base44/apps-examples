---
import AuthBootstrap from "./AuthBootstrap.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import { getServerClient, loginUrlFor } from "../lib/base44";
import { listCategories } from "../lib/store";

import type { Category } from "../lib/types";

interface Props {
  title: string;
  description?: string;
  /**
   * Set by PRERENDERED pages (see src/lib/static-nav.ts): at build time there
   * is no Base44 backend to fetch the live Category list from, so static
   * pages pass a checked-in copy for the header/footer nav instead.
   */
  staticCategories?: Category[];
}

const {
  title,
  description = "Small-batch coffee, roasted to order.",
  staticCategories,
} = Astro.props;

// Categories and the login URL are the SAME for every visitor, so computing
// them here keeps the shared header cache-safe. (Per-user state — the signed-in
// name and cart count — is hydrated on the client instead.)
// At build time (`build.format: "file"`) a prerendered page's pathname is
// "/about.html"; strip the suffix so baked-in links use the public "/about".
const currentPath = staticCategories
  ? Astro.url.pathname.replace(/\.html$/, "")
  : Astro.url.pathname;
const categories = staticCategories ?? (await listCategories(getServerClient(Astro)));
// On prerendered pages `loginUrlFor` can't resolve an app id (there is no
// Base44 runtime at build time), but the login URL is same-origin and
// identical for every visitor, so static pages bake in the canonical shape.
const loginUrl = staticCategories
  ? `/login?from=${encodeURIComponent(currentPath)}`
  : loginUrlFor(Astro, Astro.url.href);

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ctext y='26' font-size='26'%3E%E2%98%95%3C/text%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7f2" />
    <link rel="icon" href={favicon} />
    <title>{title}</title>
  </head>
  <body>
    <AuthBootstrap />
    <SiteHeader categories={categories} loginUrl={loginUrl} currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <SiteFooter categories={categories} />

    <script>
      import "../lib/ui";
    </script>

    <style is:global>
      :root {
        --bg: #faf7f2;
        --surface: #ffffff;
        --surface-2: #f4efe7;
        --ink: #2b2320;
        --ink-soft: #7a6f67;
        --line: #eae3da;
        --accent: #b5471f;
        --accent-ink: #93380f;
        --accent-teal: #3f5f52;
        --font-body: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        --font-display: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, ui-serif, serif;
        --wrap: 1120px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      img {
        max-width: 100%;
      }
      a {
        color: var(--accent-ink);
      }
      h1,
      h2,
      h3,
      h4 {
        font-family: var(--font-display);
        color: var(--ink);
        line-height: 1.15;
        letter-spacing: -0.01em;
      }
      main {
        min-height: 60vh;
      }

      .wrap {
        width: 100%;
        max-width: var(--wrap);
        margin: 0 auto;
        padding: 0 24px;
      }
      .section {
        padding: 48px 0;
      }
      .section__head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
      }
      .section__head h2 {
        font-size: clamp(1.5rem, 3vw, 2rem);
        margin: 0;
      }
      .section__head a {
        white-space: nowrap;
        font-size: 0.92rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--accent-ink);
      }
      .section__head a:hover {
        text-decoration: underline;
      }
      .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.76rem;
        font-weight: 600;
        color: var(--accent);
        margin: 0 0 8px;
      }
      .muted {
        color: var(--ink-soft);
      }

      .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 22px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font: inherit;
        font-weight: 600;
        line-height: 1;
        border: 1px solid var(--accent);
        background: var(--accent);
        color: #fff;
        border-radius: 10px;
        padding: 12px 18px;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.15s ease, transform 0.05s ease;
      }
      .btn:hover {
        background: var(--accent-ink);
        border-color: var(--accent-ink);
      }
      .btn:active {
        transform: translateY(1px);
      }
      .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .btn--sm {
        padding: 9px 13px;
        font-size: 0.85rem;
        border-radius: 8px;
      }
      .btn--ghost {
        background: transparent;
        color: var(--ink);
        border-color: var(--line);
      }
      .btn--ghost:hover {
        background: var(--surface-2);
        color: var(--ink);
        border-color: #ded4c8;
      }
      .btn--block {
        width: 100%;
      }

      label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 6px;
      }
      input,
      textarea,
      select {
        width: 100%;
        font: inherit;
        color: var(--ink);
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 11px 12px;
      }
      input:focus,
      textarea:focus,
      select:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(181, 71, 31, 0.14);
      }
      .field {
        margin-bottom: 16px;
      }

      [data-toast] {
        position: fixed;
        left: 50%;
        bottom: 28px;
        transform: translate(-50%, 20px);
        background: var(--ink);
        color: #fff;
        padding: 12px 18px;
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 500;
        box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.6);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.2s ease;
        z-index: 100;
      }
      [data-toast].is-visible {
        opacity: 1;
        transform: translate(-50%, 0);
      }
    </style>
  </body>
</html>
