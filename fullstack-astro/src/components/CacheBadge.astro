---
// Small "rendered on the server at HH:MM:SS" stamp used on the publicly cached
// pages. Because those pages are served from Base44's shared edge cache, a
// cache HIT shows an OLDER timestamp than the current time — reload a couple of
// times and watch it freeze, then jump once the cache revalidates. That's the
// whole caching story, made visible. `data-testid="rendered-at"` is here so the
// behaviour is easy to assert in tests.
import { formatTime } from "../lib/format";

interface Props {
  cached?: boolean;
}
const { cached = true } = Astro.props;
const now = new Date();
---

<div class="cache-badge">
  <span class={`cache-badge__dot ${cached ? "is-cached" : "is-live"}`} aria-hidden="true"></span>
  <span>
    {cached ? "Edge-cached" : "Personalised"} · server-rendered at
    <strong data-testid="rendered-at" title={now.toISOString()}>{formatTime(now.toISOString())}</strong>
  </span>
</div>

<style>
  .cache-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 12px;
  }
  .cache-badge strong {
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .cache-badge__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .cache-badge__dot.is-cached {
    background: var(--accent-teal);
  }
  .cache-badge__dot.is-live {
    background: var(--accent);
  }
</style>
