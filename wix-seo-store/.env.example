# Client ID of a Wix Headless OAuth app (Wix dashboard > Settings > Headless Settings).
# Leave empty to run on the built-in, clearly-marked mock catalog.
WIX_CLIENT_ID=
# Absolute public origin used for canonical URLs, og:url, JSON-LD and sitemap.
SITE_URL=http://localhost:3000
SITE_NAME=Wix SEO Store
SITE_DESCRIPTION=
# Brand logo for Organization JSON-LD: absolute URL or site path (>=112x112, square or wide).
SITE_LOGO_URL=/logo.png
# Force the Wix Stores catalog version (V1|V3). Auto-detected when unset.
WIX_CATALOG_VERSION=
